{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "COPYFILE_DISABLE=1 next build",
    "preview": "COPYFILE_DISABLE=1 next build && find .next -name '._*' -type f -delete && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview",
    "deploy": "COPYFILE_DISABLE=1 next build && find .next -name '._*' -type f -delete && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare deploy",
    "cf-build": "COPYFILE_DISABLE=1 next build && find .next -name '._*' -type f -delete && opennextjs-cloudflare build --skipNextBuild",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "import:projects": "node scripts/import-projects.mjs --dry-run",
    "import:projects:write": "node scripts/import-projects.mjs",
    "import:articles": "node scripts/import-articles.mjs --dry-run",
    "import:articles:write": "node scripts/import-articles.mjs",
    "studio": "sanity dev"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@portabletext/react": "^6.2.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "next": "^16.2.9",
    "next-sanity": "^13.1.0",
    "react": "^19.2.7",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.2.7",
    "resend": "^6.9.2",
    "sanity": "^6.0.0",
    "styled-components": "^6.4.2",
    "wrangler": "^4.100.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
